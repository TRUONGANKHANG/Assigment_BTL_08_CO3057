      },
      "source": [
        "#0/ Import thư viện"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 1,
      "metadata": {
        "id": "MGzbFZ7pyFsY"
      },
      "outputs": [],
      "source": [
        "import cv2\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "Te-Q_NGjyPNB"
      },
      "source": [
        "#1/ Load ảnh màu RGB"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 2,
      "metadata": {
        "id": "q4n2bh0YyTcL"
      },
      "outputs": [],
      "source": [
        "IMAGE_PATH = 'sample/gcl.jpg'\n",
        "\n",
        "# Load ảnh bằng OpenCV (mặc định là BGR - )\n",
        "img_bgr = cv2.imread(IMAGE_PATH)\n",
        "\n",
        "if img_bgr is None:\n",
        "    raise FileNotFoundError(f\"❌ Không tìm thấy ảnh tại: {IMAGE_PATH}\\n\"\n",
        "                          f\"   Vui lòng kiểm tra lại đường dẫn!\")"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "NrAAGR_d03pk"
      },
      "source": [
        "#2/ Chuyển đổi thứ tự kênh màu -> RGB"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 3,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "tz13hIGf1Bpj",
        "outputId": "7ca6ae51-dc05-4504-ab0d-1d67d55ceab4"
      },
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "Ảnh đã được load và chuyển sang hệ màu RGB\n",
            "  - Đường dẫn ảnh: sample/gcl.jpg\n",
            "  - Chiều cao (Height): 300 pixels\n",
            "  - Chiều rộng (Width): 400 pixels\n",
            "  - Số kênh màu (Channels): 3\n",
            "  - Kiểu dữ liệu mỗi pixel: uint8\n",
            "Thông tin pixel tại vị trí (0, 0):\n",
            "  - Red   (R): 58\n",
            "  - Green (G): 20\n",
            "  - Blue  (B): 11\n"
          ]
        }
      ],
      "source": [
        "# Chuyển từ BGR sang RGB (để hiển thị đúng màu với matplotlib)\n",
        "img_rgb = cv2.cvtColor(img_bgr, cv2.COLOR_BGR2RGB)\n",
        "\n",
        "H, W, C = img_rgb.shape\n",
        "\n",
        "print(\"Ảnh đã được load và chuyển sang hệ màu RGB\")\n",
        "print(f\"  - Đường dẫn ảnh: {IMAGE_PATH}\")\n",
        "print(f\"  - Chiều cao (Height): {H} pixels\")\n",
        "print(f\"  - Chiều rộng (Width): {W} pixels\")\n",
        "print(f\"  - Số kênh màu (Channels): {C}\")\n",
        "print(f\"  - Kiểu dữ liệu mỗi pixel: {img_rgb.dtype}\")\n",
        "\n",
        "r, g, b = img_rgb[0, 0]\n",
        "print(\"Thông tin pixel tại vị trí (0, 0):\")\n",
        "print(f\"  - Red   (R): {r}\")\n",
        "print(f\"  - Green (G): {g}\")\n",
        "print(f\"  - Blue  (B): {b}\")"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "Bc56BUW54sU9"
      },
      "source": [
        "#3/ Tách 3 kênh màu RGB"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 4,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "hk7DEZXX25Gd",
        "outputId": "cea53007-ce04-49da-8284-ec063a4be34c"
      },
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "THÔNG TIN CÁC KÊNH MÀU (R, G, B)\n",
            "  - Kích thước mỗi kênh: 300 x 400 (pixels)\n",
            "\n",
            "GIÁ TRỊ CƯỜNG ĐỘ TRUNG BÌNH\n",
            "  - Kênh Red   (R): 157.57\n",
            "  - Kênh Green (G): 150.39\n",
            "  - Kênh Blue  (B): 142.45\n"
          ]
        }
      ],
      "source": [
        "channel_R = img_rgb[:, :, 0]  # Kênh Red\n",
        "channel_G = img_rgb[:, :, 1]  # Kênh Green\n",
        "channel_B = img_rgb[:, :, 2]  # Kênh Blue\n",
        "\n",
        "H, W = channel_R.shape\n",
        "\n",
        "print(\"THÔNG TIN CÁC KÊNH MÀU (R, G, B)\")\n",
        "print(f\"  - Kích thước mỗi kênh: {H} x {W} (pixels)\")\n",
        "\n",
        "print(\"\\nGIÁ TRỊ CƯỜNG ĐỘ TRUNG BÌNH\")\n",
        "print(f\"  - Kênh Red   (R): {channel_R.mean():.2f}\")\n",
        "print(f\"  - Kênh Green (G): {channel_G.mean():.2f}\")\n",
        "print(f\"  - Kênh Blue  (B): {channel_B.mean():.2f}\")"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "-qiNU7cB254G"
      },
      "source": [
        "#4/ Chuyển ành màu sang xám"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 5,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "EoR7WUNh20sI",
        "outputId": "20a4f9d6-18cb-4a06-8bae-cba378f824a9"
      },
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "KẾT QUẢ CHUYỂN ĐỔI ẢNH RGB → ẢNH XÁM\n",
            "  - Kích thước ảnh xám: 300 x 400 (pixels)\n",
            "  - Kiểu dữ liệu ảnh xám (manual): uint8\n",
            "  - Kiểu dữ liệu ảnh xám (OpenCV): uint8\n",
            "SO SÁNH PHƯƠNG PHÁP MANUAL VÀ OPENCV\n",
            "  - Sai số nhỏ nhất giữa các pixel: 0\n",
            "  - Sai số lớn nhất giữa các pixel: 1\n",
            "  - Sai số trung bình giữa các pixel: 0.5011\n",
            "  - Số pixel có sai khác: 60127 / 120000\n",
            "  - Tỷ lệ pixel sai khác: 50.105833%\n"
          ]
        }
      ],
      "source": [
        "img_gray_manual = (0.299 * channel_R +\n",
        "                   0.587 * channel_G +\n",
        "                   0.114 * channel_B).astype(np.uint8)\n",
        "\n",
        "# So sánh với hàm OpenCV (sử dụng cùng công thức)\n",
        "img_gray_opencv = cv2.cvtColor(img_rgb, cv2.COLOR_RGB2GRAY)\n",
        "\n",
        "H, W = img_gray_manual.shape\n",
        "\n",
        "diff = img_gray_manual.astype(int) - img_gray_opencv.astype(int)\n",
        "abs_diff = np.abs(diff)\n",
        "\n",
        "print(\"KẾT QUẢ CHUYỂN ĐỔI ẢNH RGB → ẢNH XÁM\")\n",
        "print(f\"  - Kích thước ảnh xám: {H} x {W} (pixels)\")\n",
        "print(f\"  - Kiểu dữ liệu ảnh xám (manual): {img_gray_manual.dtype}\")\n",
        "print(f\"  - Kiểu dữ liệu ảnh xám (OpenCV): {img_gray_opencv.dtype}\")\n",
        "\n",
        "print(\"SO SÁNH PHƯƠNG PHÁP MANUAL VÀ OPENCV\")\n",
        "print(f\"  - Sai số nhỏ nhất giữa các pixel: {abs_diff.min()}\")\n",
        "print(f\"  - Sai số lớn nhất giữa các pixel: {abs_diff.max()}\")\n",
        "print(f\"  - Sai số trung bình giữa các pixel: {abs_diff.mean():.4f}\")\n",
        "\n",
        "num_diff = np.count_nonzero(abs_diff)\n",
        "total_pixel = H * W\n",
        "print(f\"  - Số pixel có sai khác: {num_diff} / {total_pixel}\")\n",
        "print(f\"  - Tỷ lệ pixel sai khác: {num_diff / total_pixel * 100:.6f}%\")"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "EsqzHY1l5dYS"
      },
      "source": [
        "#5/ Kết hợp các kênh màu\n",
        "- Hoán đổi kênh màu\n",
        "- Thay thế 1 kênh nào đó bằng 1 giá trị bất kì\n",
        "   - Đăt 1 kênh bằng 0\n",
        "   - Thay 1 kênh bằng kênh khác"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 6,
      "metadata": {
        "id": "K2hImJRf6g4M"
      },
      "outputs": [],
      "source": [
        "# 4a. Tái tạo lại ảnh màu ban đầu\n",
        "img_reconstructed = cv2.merge([channel_R, channel_G, channel_B])\n",
        "\n",
        "# 4b. Hoán đổi kênh màu\n",
        "img_BGR = cv2.merge([channel_B, channel_G, channel_R])\n",
        "img_GBR = cv2.merge([channel_G, channel_B, channel_R])\n",
        "img_RBG = cv2.merge([channel_R, channel_B, channel_G])\n",
        "\n",
        "# 4c. Thay thế kênh\n",
        "img_RG_gray = cv2.merge([channel_R, channel_G, img_gray_manual])\n",
        "img_R_R_B = cv2.merge([channel_R, channel_R, channel_B])\n",
        "img_no_R = cv2.merge([np.zeros_like(channel_R), channel_G, channel_B])\n",
        "img_no_G = cv2.merge([channel_R, np.zeros_like(channel_G), channel_B])\n",
        "img_no_B = cv2.merge([channel_R, channel_G, np.zeros_like(channel_B)])"
      ]
    },
